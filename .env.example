# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER prefix with NEXT_PUBLIC_, never import from a "use client" file.
# Used by src/lib/supabase/admin.ts and scripts/bootstrap-super-admin.ts only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only needed if linking the Supabase CLI to the hosted project (supabase link).
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-db-password
